<odoo>

    <record id="reassign_tasks_wizard" model="ir.ui.view">
        <field name="name">Reassign Tasks</field>
        <field name="model">reassign_tasks.wizard</field>
        <field name="arch" type="xml">
            <form string="Reassign User or Team">
                <group col="4" colspan="4">
                    <field name="reassign_to" widget="radio"/>
                    <newline/>
                    <field name="team_id" options="{'no_create': True}"
                           context="{'default_type_team':'support'}"
                           attrs="{'invisible': [('reassign_to','!=', 'team')], 'required': [('reassign_to','=', 'team')]}"/>
                    <newline/>
                    <field name="assigned_to" options="{'no_create': True}"
                           attrs="{'required': [('reassign_to','=', 'user')]}"
                           domain="assigned_to_domain"/>
                    <field name="send_notifications"/>
                    <field name="assigned_to_domain" invisible="1"/>
                    <newline/>
                    <field name="name"/>
                    <field name="reassign_subtasks"/>
                    <field name="email_template_id"/>
                    <field name="task_id" invisible="1"/>
                </group>
                <group>
                    <field name="description"/>
                </group>
                <group string="Selected Tasks">
                    <field name="task_ids" nolabel="1">
                        <tree>
                            <field name="create_date"/>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="tag_ids"/>
                            <field name="id"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="reassign_tasks"
                            string="Reassign" type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reassign_tasks_wizard" model="ir.actions.act_window">
        <field name="name">Reassign Tasks</field>
        <field name="res_model">reassign_tasks.wizard</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_task_ids': active_ids}</field>
        <field name="target">new</field>
    </record>

</odoo>
